<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgPrimary"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="?attr/textPrimary"
            android:textSize="30sp"
            app:layout_constraintEnd_toStartOf="@id/settingsButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tagline"
            android:textColor="?attr/textSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/settingsButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brandTitle" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/settings"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/textPrimary" />

        <!-- Exit / app-close button (classic power icon, below settings) -->
        <ImageButton
            android:id="@+id/exitButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/exit"
            android:padding="12dp"
            android:src="@drawable/ic_exit"
            app:layout_constraintEnd_toEndOf="@id/settingsButton"
            app:layout_constraintTop_toBottomOf="@id/settingsButton"
            app:tint="?attr/textPrimary" />

        <!-- Barrier that spans the taller of the left column (tagline) and the
             right column (settings + exit buttons) so the recording section
             starts below both. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/topContentBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tagline,exitButton"
            app:barrierDirection="bottom" />

        <!-- Recording section -->
        <!-- ALSA analog gain status indicator (persistent, visible always) -->
        <TextView
            android:id="@+id/alsaStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/alsa_status_idle"
            android:textColor="?attr/alsaStatusIdleColor"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topContentBarrier" />

        <!-- Control type toggle (Gain vs Level) -->
        <TextView
            android:id="@+id/controlTypeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/control_type_label"
            android:textColor="?attr/textSecondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/alsaStatusText" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/controlTypeToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controlTypeLabel">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/controlGainButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/control_gain"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/controlLevelButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/control_level"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/recordingSectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/recording_section"
            android:textColor="?attr/textSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controlTypeToggle" />

        <TextView
            android:id="@+id/formatLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/format_label"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recordingSectionLabel" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/formatToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formatLabel">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatWav16Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/format_wav16"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatWav24Button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/format_wav24"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/formatM4aButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/format_m4a"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/formatNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/format_note"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formatToggle" />

        <TextView
            android:id="@+id/bitrateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/bitrate_label"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/formatNote" />

        <Spinner
            android:id="@+id/bitrateSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bitrateLabel" />

        <TextView
            android:id="@+id/bitrateHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/bitrate_hint"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bitrateSpinner" />

        <!-- Sample rate (always shown; available rates are filtered per-device). -->
        <TextView
            android:id="@+id/sampleRateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sample_rate_label"
            android:textColor="?attr/textPrimary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bitrateHint" />

        <Spinner
            android:id="@+id/sampleRateSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sampleRateLabel" />

        <TextView
            android:id="@+id/sampleRateHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sample_rate_hint"
            android:textColor="?attr/textSecondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sampleRateSpinner" />

        <!-- Recording live panel -->
        <LinearLayout
            android:id="@+id/recordingPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sampleRateHint">

            <TextView
                android:id="@+id/elapsedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/recording_elapsed_default"
                android:textColor="?attr/dangerColor"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <FrameLayout
                    android:id="@+id/meterMic1Container"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <FrameLayout
                    android:id="@+id/meterMic2Container"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peak_mic1"
                        android:textColor="?attr/textSecondary"
                        android:textSize="11sp" />

                    <!-- Tap to reset (DAW-style). clickable+focusable make the label a
                         reliable hit target even with a small text size. -->
                    <TextView
                        android:id="@+id/peakMic1Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="−∞ dB"
                        android:textColor="?attr/meterPeakColor"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peak_mic2"
                        android:textColor="?attr/textSecondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/peakMic2Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-black"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="−∞ dB"
                        android:textColor="?attr/meterPeakColor"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Record / Stop buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/button_record"
            android:textColor="#FFFFFFFF"
            app:backgroundTint="?attr/recordColor"
            app:icon="@drawable/ic_record_dot"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFFFF"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/recordingPanel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/button_stop"
            android:textColor="?attr/textPrimary"
            android:visibility="gone"
            app:backgroundTint="?attr/bgSecondary"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconTint="?attr/textPrimary"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/recordingPanel" />

        <!-- Barrier so Microphone gain section follows whichever of
             recordButton / stopButton is currently visible (only one is
             shown at a time). Without this, gainSectionLabel is pinned to
             recordButton — which is GONE while recording — and the label
             overlaps the visible stopButton. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/recordStopBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="recordButton,stopButton"
            app:barrierDirection="bottom" />

        <!-- Microphone gain section (follows whichever button is visible) -->
        <TextView
            android:id="@+id/gainSectionLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/gain_label"
            android:textColor="?attr/textSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recordStopBarrier" />

        <!-- Mic 1 -->
        <LinearLayout
            android:id="@+id/mic1Panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gainSectionLabel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mic1Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/mic1_label"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mic1Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0 dB"
                    android:textColor="?attr/gainActiveColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/mic1Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="-24"
                android:valueTo="24"
                app:haloColor="?attr/gainGlowColor"
                app:labelBehavior="floating"
                app:thumbColor="?attr/gainActiveColor"
                app:tickVisible="false"
                app:trackColorActive="?attr/gainActiveColor"
                app:trackColorInactive="?attr/gainTrackColor" />
        </LinearLayout>

        <!-- Mic 2 -->
        <LinearLayout
            android:id="@+id/mic2Panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mic1Panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mic2Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/mic2_label"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/mic2Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0 dB"
                    android:textColor="?attr/gainActiveColor"
                    android:textSize="18sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/mic2Slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="-24"
                android:valueTo="24"
                app:haloColor="?attr/gainGlowColor"
                app:labelBehavior="floating"
                app:thumbColor="?attr/gainActiveColor"
                app:tickVisible="false"
                app:trackColorActive="?attr/gainActiveColor"
                app:trackColorInactive="?attr/gainTrackColor" />
        </LinearLayout>

        <!-- Link row -->
        <LinearLayout
            android:id="@+id/linkRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mic2Panel">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/link_label"
                    android:textColor="?attr/textPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/link_hint"
                    android:textColor="?attr/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/linkSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Headphone monitor section ("Live listen") -->
        <LinearLayout
            android:id="@+id/monitorPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linkRow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/monitor_label"
                        android:textColor="?attr/textPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/monitorStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/monitor_off"
                        android:textColor="?attr/monitorInactiveColor"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/monitorSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Live-listen volume: visible only while monitoring is active AND
                 headphones are connected. A single slider that adjusts BOTH
                 channels by the same value (AudioTrack.setVolume is per-instance
                 and channel-symmetric, so this never touches the system media
                 volume — only the Live-listen playback). -->
            <LinearLayout
                android:id="@+id/monitorVolumeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/monitor_volume_label"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/monitorVolumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0%"
                    android:textColor="?attr/gainActiveColor"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Signed scale (-100..+100; 0 = unity). Negative = attenuation,
                 positive = boost. Boost above the platform's
                 AudioTrack.getMaxVolume() is delivered as a per-sample buffer
                 multiplication in the monitor tap (so the user can actually
                 hear amplification on devices where setVolume alone is capped
                 at unity). -->
            <com.google.android.material.slider.Slider
                android:id="@+id/monitorVolumeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="-100"
                android:valueTo="100"
                android:visibility="gone"
                app:haloColor="?attr/gainGlowColor"
                app:labelBehavior="floating"
                app:thumbColor="?attr/gainActiveColor"
                app:tickVisible="false"
                app:trackColorActive="?attr/gainActiveColor"
                app:trackColorInactive="?attr/gainTrackColor" />

            <!-- Max attenuation/boost in dB that the volume slider above can
                 reach at its extremes. 0 locks the volume slider at 0 %; 75
                 gives it the widest possible ±75 dB reach. Default 20 dB so
                 the slider covers the same ±20 dB range as the per-mic gain
                 scale on first launch. -->
            <LinearLayout
                android:id="@+id/monitorMaxDbRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/monitor_max_db_label"
                    android:textColor="?attr/textPrimary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/monitorMaxDbValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="±20 dB"
                    android:textColor="?attr/gainActiveColor"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/monitorMaxDbSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:stepSize="1"
                android:value="20"
                android:valueFrom="0"
                android:valueTo="75"
                android:visibility="gone"
                app:haloColor="?attr/gainGlowColor"
                app:labelBehavior="floating"
                app:thumbColor="?attr/gainActiveColor"
                app:tickVisible="false"
                app:trackColorActive="?attr/gainActiveColor"
                app:trackColorInactive="?attr/gainTrackColor" />

            <TextView
                android:id="@+id/monitorHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/monitor_hint"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
